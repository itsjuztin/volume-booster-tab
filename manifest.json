{
  "manifest_version": 3,
  "name": "Volume Booster & Equalizer for Tabs",
  "version": "1.0.2",
  "description": "Per-tab volume booster up to 1000% with soft limiter, 3-band equalizer, and zero ads.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "tabs",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Volume Booster & Equalizer for Tabs"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
